PORT=8080
# Obligatoria. La clave y el modelo se quedan en el backend: nunca llegan al navegador
GEMINI_API_KEY=
# Modelo de la API Live de Gemini; cámbialo aquí sin tocar código
GEMINI_MODEL=gemini-3.8-live
# Opcional: carta del restaurante. El host es el del lado del servidor SSH.
DATABASE_URL=postgres://USUARIO:CONTRASEÑA@127.0.0.1:5432/NOMBRE_BD
# El backend abre el túnel SSH él mismo; vacío: conexión directa
DB_SSH=usuario@host-ssh
DB_SSH_KEY=~/.ssh/id_ed25519
# Copia local de la carta (contenedor krat-redis, ver README)
REDIS_URL=redis://127.0.0.1:6379/0
